{
  "name": "github-trending-push",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "每天推送 GitHub 今日涨星、AI 圈要闻，交易日早盘推送潜力股，到 Telegram 和邮箱",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/github-trending/main.ts",
    "dry-run": "node src/github-trending/main.ts --dry-run",
    "stocks": "node src/stocks/main.ts",
    "stocks:dry-run": "node src/stocks/main.ts --dry-run",
    "ai-news": "node src/ai-news/main.ts",
    "ai-news:dry-run": "node src/ai-news/main.ts --dry-run",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17"
  }
}
